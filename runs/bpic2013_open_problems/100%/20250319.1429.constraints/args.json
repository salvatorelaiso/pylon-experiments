{
    "seed": 42,
    "epochs": 100,
    "learning_rate": 0.0001,
    "dataset": "bpic2013_open_problems/100%",
    "model": {
        "embedding": 50,
        "hidden_size": 32,
        "num_layers": 2,
        "dropout": 0.2
    },
    "constraints": [
        "Absence3[Accepted]*0.76"
    ],
    "ignore_task_loss": false,
    "constraints_multiplier": 0.1
}
