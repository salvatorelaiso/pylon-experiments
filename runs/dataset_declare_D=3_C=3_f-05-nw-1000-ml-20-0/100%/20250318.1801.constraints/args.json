{
    "seed": 42,
    "epochs": 100,
    "learning_rate": 0.0001,
    "dataset": "dataset_declare_D=3_C=3_f-05-nw-1000-ml-20-0/100%",
    "model": {
        "embedding": 50,
        "hidden_size": 32,
        "num_layers": 2,
