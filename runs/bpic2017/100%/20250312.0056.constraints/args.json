{
    "seed": 42,
    "epochs": 100,
    "learning_rate": 0.0001,
    "dataset": "bpic2017/100%",
    "model": {
        "embedding": 50,
        "hidden_size": 32,
        "num_layers": 2,
        "dropout": 0.2
    },
    "constraints": [
        "Exactly1[A_Accepted]",
        "Alternate Succession[A_Accepted, A_Complete]",
        "Alternate Succession[A_Concept, A_Accepted]",
        "Alternate Succession[A_Create Application, A_Accepted]"
    ],
    "ignore_task_loss": false,
    "constraints_multiplier": 0.1
}
